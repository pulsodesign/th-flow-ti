# Copie este arquivo para .env (desenvolvimento) ou configure as mesmas
# variáveis no servidor. Nunca envie o .env para o repositório.

# Banco PostgreSQL (obrigatório). Com SSL em produção: ...?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host:5432/thflow"
# Conexão direta, sem pooler, usada para o tempo real (LISTEN/NOTIFY).
# Opcional: se vazio, usa DATABASE_URL (e tira "-pooler" do host, no caso do Neon).
DATABASE_URL_DIRETA=""
# Máximo de conexões simultâneas do servidor (padrão 10).
DATABASE_POOL_MAX="10"

# Endereço público do app, usado nos links dos e-mails. Ex.: https://thflow.empresa.com.br
APP_URL=""

# E-mails (Resend). Sem estas chaves, os links são escritos no log do servidor.
RESEND_API_KEY=""
EMAIL_REMETENTE="TH Flow <nao-responda@empresa.com.br>"

# "false" só em desenvolvimento local sem HTTPS (o cookie de sessão deixa de ser Secure).
COOKIE_SEGURO=""
# "false" desliga as rotinas diárias dentro do servidor (para rodar em um agendador externo).
ROTINAS_INTERNAS=""

# Porta HTTP do servidor (padrão 3000).
PORT="3000"
